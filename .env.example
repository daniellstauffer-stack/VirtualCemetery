# =============================================================================
# Virtual Cemetery — Environment Configuration & Service Account Placeholders
# =============================================================================
# Copy this file to `.env` for local development.
# NEVER commit `.env` or real production credentials to GitHub.
# In Google Cloud (staging/production), store secrets in Google Secret Manager
# and bind them to Cloud Run services via Terraform (see `infra/`).
# =============================================================================

# --- Core Django Settings ----------------------------------------------------
DJANGO_ENV=development
DJANGO_DEBUG=True
DJANGO_SECRET_KEY=replace-with-strong-random-50-char-secret-key
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
SITE_BASE_URL=http://localhost:8000
PILOT_JURISDICTION=Oregon, United States
SUPPORT_EMAIL=support@example-virtualcemetery.org
OPERATOR_NAME=Virtual Cemetery Pilot Operator

# --- Database (Cloud SQL for PostgreSQL in staging/production) ---------------
# Local Docker Compose uses PostgreSQL automatically; local bare-metal falls
# back to SQLite when DATABASE_URL is left empty.
DATABASE_URL=
# Example PostgreSQL URL:
# DATABASE_URL=postgresql://vc_app:REPLACE_DB_PASSWORD@127.0.0.1:5432/virtualcemetery
# Cloud SQL Unix socket example on Cloud Run:
# DATABASE_URL=postgresql://vc_app:REPLACE_DB_PASSWORD@/virtualcemetery?host=/cloudsql/YOUR_GCP_PROJECT_ID:us-west1:vc-staging-pg

# --- Google Cloud Platform (GCP) ---------------------------------------------
GCP_PROJECT_ID=your-gcp-project-id-placeholder
GCP_REGION=us-west1
GCP_MEDIA_BUCKET=your-gcp-project-vc-private-media
GCP_EVIDENCE_BUCKET=your-gcp-project-vc-case-evidence
GCP_EVIDENCE_RETENTION_DAYS=90
USE_GCS_STORAGE=False

# --- Google Cloud Identity Platform (Authentication & MFA) -------------------
# Set LOCAL_AUTH_EMULATOR=True for local development without live GCP auth.
LOCAL_AUTH_EMULATOR=True
GCP_IDENTITY_PLATFORM_PROJECT_ID=your-gcp-project-id-placeholder
GCP_IDENTITY_PLATFORM_API_KEY=your-identity-platform-web-api-key-placeholder
GCP_IDENTITY_PLATFORM_AUTH_DOMAIN=your-gcp-project-id-placeholder.firebaseapp.com
# Optional: point to Firebase/Identity Platform Auth Emulator locally
IDENTITY_PLATFORM_EMULATOR_HOST=

# --- Google Cloud Tasks (Background Worker Queue) ----------------------------
CLOUD_TASKS_ENABLED=False
GCP_TASKS_LOCATION=us-west1
GCP_TASKS_QUEUE_NAME=vc-background-jobs
WORKER_BASE_URL=https://vc-worker-REPLACE-uc.a.run.app
WORKER_OIDC_SERVICE_ACCOUNT=vc-tasks-invoker@your-gcp-project-id-placeholder.iam.gserviceaccount.com
WORKER_SHARED_SECRET=replace-with-local-worker-shared-secret

# --- Transactional Email Provider (Postmark) ---------------------------------
# Set EMAIL_PROVIDER=console or smtp (Mailpit) locally; postmark in staging/prod
EMAIL_PROVIDER=console
EMAIL_FROM_ADDRESS=no-reply@example-virtualcemetery.org
EMAIL_FROM_NAME=Virtual Cemetery
POSTMARK_SERVER_TOKEN=your-postmark-server-token-placeholder
POSTMARK_MESSAGE_STREAM=outbound
POSTMARK_WEBHOOK_SECRET=your-postmark-webhook-secret-placeholder
# Local SMTP (Mailpit in docker-compose)
SMTP_HOST=localhost
SMTP_PORT=1025
# Staging safety guardrail: comma-separated allowed recipient domains/emails
STAGING_ALLOWED_EMAIL_RECIPIENTS=

# --- Facebook / Meta (Optional Login & Future Approved Graph API Import) -----
# Note: Guided import from a user-downloaded Facebook JSON export works out of
# the box without Meta App Review. Connected-account Login/Graph API requires
# Meta App Review approval before enabling in production.
FACEBOOK_LOGIN_ENABLED=False
FACEBOOK_APP_ID=your-meta-facebook-app-id-placeholder
FACEBOOK_APP_SECRET=your-meta-facebook-app-secret-placeholder
FACEBOOK_REDIRECT_URI=http://localhost:8000/integrations/facebook/callback/
FACEBOOK_GRAPH_API_VERSION=v21.0

# --- Google People API (Optional Future Contact Import) ----------------------
GOOGLE_PEOPLE_IMPORT_ENABLED=False
GOOGLE_OAUTH_CLIENT_ID=your-google-oauth-client-id-placeholder.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=your-google-oauth-client-secret-placeholder
GOOGLE_PEOPLE_REDIRECT_URI=http://localhost:8000/integrations/contacts/google/callback/

# --- Microsoft Graph API (Optional Future Contact Import) --------------------
MICROSOFT_GRAPH_IMPORT_ENABLED=False
MICROSOFT_TENANT_ID=common
MICROSOFT_CLIENT_ID=your-microsoft-entra-client-id-placeholder
MICROSOFT_CLIENT_SECRET=your-microsoft-entra-client-secret-placeholder
MICROSOFT_REDIRECT_URI=http://localhost:8000/integrations/contacts/microsoft/callback/

# --- Google Places API (Optional Local Professional Directory Expansion) -----
# Pilot starts with curated providers & official state licensing links.
GOOGLE_PLACES_ENABLED=False
GOOGLE_PLACES_API_KEY=your-google-places-api-key-placeholder
GOOGLE_PLACES_DAILY_QUOTA=250

# --- Stripe Hosted Checkout (Optional Voluntary Site Support) ----------------
STRIPE_ENABLED=False
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key_placeholder
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key_placeholder
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret_placeholder
STRIPE_CURRENCY=usd
STRIPE_PAYEE_LEGAL_NAME=Virtual Cemetery Operator LLC (Placeholder)
STRIPE_TAX_DEDUCTIBLE_STATUS=Contributions are voluntary gifts to support site hosting and operations and are NOT tax-deductible unless formally updated after tax-exempt determination.
